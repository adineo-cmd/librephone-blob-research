---
import Base from '../../layouts/Base.astro';
import { loadLinks } from '../../lib/data';
const links = loadLinks();
const byFam: Record<string, typeof links> = {};
for (const l of links) for (const fam of l.families.split(',')) if (fam.trim()) (byFam[fam.trim()] ||= []).push(l);
---
<Base title="External code">
  <h2>External firmware and code</h2>
  <p>Sites that host open-source firmware, blobs and code across all device
  classes. None of this content is re-published here; each link was opened and
  verified before being committed to <code>site/data/links.csv</code>.</p>
  {Object.keys(byFam).sort().map((fam) => <section>
    <h3>{fam}</h3>
    <ul>{byFam[fam].map((l) => <li><a href={l.url}>{l.title}</a> — {l.organisation}. {l.what_it_hosts}. Verified {l.verified_date}.</li>)}</ul>
  </section>)}
</Base>
