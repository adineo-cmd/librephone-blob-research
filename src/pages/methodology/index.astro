import Base from '../../layouts/Base.astro';
---
<Base title="Methodology">
  <h2>Methodology</h2>
  <h3>Evidence classes</h3>
  <p>Every claim carries [F] fact, [I] inference, [H] hypothesis or [N]
  negative, rendered as an inline marker.</p>
  <h3>Facts, not blobs</h3>
  <p>No proprietary payload is ever committed. Only hashes, sizes, offsets,
  counts and short hex samples.</p>
  <h3>Coverage states</h3>
  <p>Catalogued: per-file rows exist. Count-known: an upstream count exists but
  no per-file layer. Inventory-only: neither.</p>
  <h3>Leverage</h3>
  <p>Ranked by device reach, not row count.</p>
  <h3>Website</h3>
  <p><a href="https://adineo-cmd.github.io/open-device/">https://adineo-cmd.github.io/open-device/</a></p>
</Base>
