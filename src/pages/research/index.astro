---
import Base from '../../layouts/Base.astro';
import { buildDocs } from '../../lib/data';
const docs = buildDocs();
---
<Base title="Research">
  <h2>Research documents</h2>
  <p>{docs.length} evidence-classed documents. Every claim carries [F] fact,
  [I] inference, [H] hypothesis or [N] negative.</p>
  <ul>
    {docs.map((d) => <li><a href={`research/${d.path.replace(/\.md$/, '.html')}`}>{d.title || d.path}</a> {d.evidence_classes.map((c) => <span class="evidence" data-evidence={c.toLowerCase()}>{c}</span>)}</li>)}
  </ul>
</Base>
